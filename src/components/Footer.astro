---
import { t, type Lang } from '../i18n/utils';
import MotionToggle from './MotionToggle.astro';
interface Props { lang: Lang }
const { lang } = Astro.props;
---
<footer class="site-footer wrap">
  <p>{t(lang, 'footer.copyright')}</p>
  <p>{t(lang, 'footer.wcag')}</p>
  <MotionToggle lang={lang} place="footer" />
</footer>
<style>
  .site-footer {
    display: flex; flex-wrap: wrap; align-items: center; gap: 12px 24px;
    padding-block: 40px; color: var(--muted); font: 400 13px/1.4 var(--font-mono);
  }
  .site-footer p { margin: 0 }
  .site-footer :global(.motion-toggle) { margin-left: auto }
  @media (max-width: 560px) { .site-footer :global(.motion-toggle) { margin-left: 0 } }
</style>
