---
import { localizePath, switchLangPath, t, type Lang } from '../i18n/utils';
interface Props { lang: Lang }
const { lang } = Astro.props;
const target: Lang = lang === 'en' ? 'pl' : 'en';
// The 404 page has no translated twin, so its switch goes to the other home page.
const isNotFound = /\/404(\.html|\/)?$/.test(Astro.url.pathname);
const href = isNotFound ? localizePath('/', target) : switchLangPath(Astro.url, target);
const options: Lang[] = ['en', 'pl'];
---
<!-- Segmented EN | PL: the whole pill is one link to the other language (works without JS). -->
<a class="seg lang-seg" data-current={lang} href={href} hreflang={target} lang={target} data-lang-switch aria-label={`${t(lang, 'lang.label')} – ${t(lang, 'a11y.switchLang')}`}>
  <span class="seg-thumb" aria-hidden="true"></span>
  {options.map((option) => (
    <span class:list={['seg-option', option === lang ? 'is-current' : 'is-target']} lang={option}>{option.toUpperCase()}</span>
  ))}
</a>
