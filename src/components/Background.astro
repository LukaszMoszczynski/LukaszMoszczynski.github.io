---
// Global blueprint grid and cursor light. Persisted across view transitions,
// so its script starts once per full page load (see src/scripts/background.ts).
---
<div class="background" transition:persist="background" aria-hidden="true">
  <div class="grid-layer"></div>
  <div class="light-layer"><div class="glow glow-a"></div><div class="glow glow-b"></div></div>
</div>
<script>
  import { initBackground } from '../scripts/background';
  initBackground();
</script>
<style is:global>
  .grid-layer, .light-layer { position: fixed; inset: 0; z-index: -1; pointer-events: none; overflow: hidden }
  .grid-layer > span { position: absolute }
  .grid-layer .v { top: 0; bottom: 0; width: 1px; background: var(--grid); transform-origin: 50% 0 }
  .grid-layer .h { left: 0; right: 0; height: 1px; background: var(--grid); transform-origin: 0 50% }
  .grid-layer .tv { width: 2px; margin-left: -.5px }
  .grid-layer .th { height: 2px; margin-top: -.5px }
  .grid-layer .dot {
    width: 8px; height: 8px; margin: -3.5px 0 0 -3.5px; border-radius: 50%; background: var(--accent);
    box-shadow: 0 0 12px 4px color-mix(in srgb, var(--accent) 70%, transparent);
  }
  .grid-layer .cell {
    left: 0; top: 0; width: 96px; height: 96px; opacity: 0; transition: opacity .3s;
    background: color-mix(in srgb, var(--accent) 7%, transparent);
    box-shadow: inset 0 0 0 1px color-mix(in srgb, var(--accent) 35%, transparent);
  }
  .grid-layer .ring {
    width: 14px; height: 14px; margin: -7px 0 0 -7px; border-radius: 50%; border: 1.5px solid var(--accent);
  }
  .light-layer .glow {
    position: absolute; left: 0; top: 0; width: 46vmax; height: 46vmax; border-radius: 50%; filter: blur(70px);
  }
  .light-layer .glow-a { background: radial-gradient(circle, var(--glow-a), transparent 65%); transform: translate(40vw, -5vmax) }
  .light-layer .glow-b { background: radial-gradient(circle, var(--glow-b), transparent 65%); transform: translate(-10vw, 10vmax) }
</style>
