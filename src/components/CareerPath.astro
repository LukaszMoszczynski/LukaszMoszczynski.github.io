---
import ArrowLink from './ArrowLink.astro';
import { t, type Lang } from '../i18n/utils';
import type { UiKey } from '../i18n/ui';
interface Props { lang: Lang }
const { lang } = Astro.props;

const entries: { year: string; slug: string; text: boolean; link?: string }[] = [
  { year: '2007', slug: '2007', text: true },
  { year: '2012', slug: '2012', text: true },
  { year: '2017', slug: '2017', text: true, link: 'https://lukaszmoszczynski.github.io/portfolio-2019/' },
  { year: '2019', slug: '2019', text: true },
  { year: '2021', slug: '2021', text: false },
  { year: '2022', slug: '2022', text: false },
  { year: '2024', slug: '2024', text: true },
  { year: t(lang, 'path.now.year'), slug: 'now', text: true },
];
const key = (slug: string, part: string) => `path.${slug}.${part}` as UiKey;
---
<section class="career wrap" id="career" aria-labelledby="career-heading">
  <div class="career-head">
    <p class="career-kicker">{t(lang, 'path.kicker')}</p>
    <h2 id="career-heading">{t(lang, 'path.heading')}</h2>
  </div>
  <ol class="tl">
    {entries.map((entry) => (
      <li>
        <span class="yr">{entry.year}</span>
        <div>
          <b>{t(lang, key(entry.slug, 'title'))}</b>
          {entry.text && (
            <p>
              {t(lang, key(entry.slug, 'text'))}
              {entry.link && <> <ArrowLink href={entry.link} label={t(lang, 'path.2017.link')} /></>}
            </p>
          )}
        </div>
      </li>
    ))}
  </ol>
</section>
<script>
  import { motionEnabled, onPage } from '../scripts/lifecycle';
  import { initCareerPath } from '../scripts/career-path';
  onPage(() => {
    const root = document.querySelector<HTMLElement>('.career');
    return root && motionEnabled() ? initCareerPath(root) : undefined;
  });
</script>
<style is:global>
  .career { padding-block: 20px 120px; display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1.4fr); gap: 40px; align-items: start }
  .career-kicker { font-family: var(--font-mono); font-size: 13px; color: var(--accent-ink); margin: 0 0 12px }
  .career h2 { font-family: var(--font-display); font-weight: 700; font-size: clamp(28px, 4vw, 54px); letter-spacing: -.035em; line-height: 1.05; margin: 0; text-wrap: balance }
  .career .tl { list-style: none; margin: 0; padding: 0 0 0 40px; position: relative; display: grid; gap: 34px }
  .career .tl::before { content: ""; position: absolute; left: 7px; top: 6px; bottom: 6px; width: 2px; background: var(--line) }
  .career .tl-progress { position: absolute; left: 7px; top: 6px; bottom: 6px; width: 2px; background: linear-gradient(var(--violet), var(--accent)); transform-origin: 50% 0 }
  .career .tl-dot { position: absolute; left: 8px; top: 6px; width: 14px; height: 14px; margin: -7px 0 0 -7px; border-radius: 50%; background: var(--accent); box-shadow: 0 0 16px 4px color-mix(in srgb, var(--accent) 60%, transparent) }
  .career .tl li { display: grid; grid-template-columns: 60px minmax(0, 1fr); gap: 16px; position: relative; transition: opacity .4s }
  .career .tl li::before { content: ""; position: absolute; left: -38px; top: 7px; width: 10px; height: 10px; border-radius: 50%; background: var(--bg); box-shadow: 0 0 0 2px var(--line); transition: box-shadow .4s, background .4s }
  .career .tl li.lit::before { background: var(--accent); box-shadow: 0 0 0 2px var(--accent) }
  .career .tl.js li:not(.lit) { opacity: .35 }
  .career .yr { font-family: var(--font-mono); font-size: 13px; color: var(--accent-ink); padding-top: 2px }
  .career .tl b { font-family: var(--font-display); font-weight: 600; font-size: 18px; letter-spacing: -.01em; line-height: 1.3 }
  .career .tl p { margin: 4px 0 0; color: var(--muted) }
  @media (min-width: 861px) { .career-head { position: sticky; top: 110px } }
  @media (max-width: 860px) { .career { grid-template-columns: minmax(0, 1fr); padding-block: 12px 72px } }
</style>
