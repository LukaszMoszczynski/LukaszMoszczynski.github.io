---
import { t, type Lang } from '../i18n/utils';
import type { UiKey } from '../i18n/ui';
import { DEGREES_PER_NODE, FACTORY_NODES, FACTORY_STAGES } from '../scripts/factory-sequence';
interface Props { lang: Lang; transitionName?: string }
const { lang, transitionName } = Astro.props;

// Diagram geometry, in viewBox units. Kept in sync with factory-loop.ts through data attributes.
const WIDTH = 560;
const HEIGHT = 440;
const CENTER = { x: 280, y: 225 };
const RADIUS = 130;
const LABEL_GAP = 26;
const TOP_GAP = 50; // the Jira label is a 40px button and must clear its node at phone scale

const percent = (value: number, total: number) => `${Math.round((value / total) * 1000) / 10}%`;
const nodes = FACTORY_NODES.map((stage, index) => {
  const angle = (index * DEGREES_PER_NODE * Math.PI) / 180;
  const x = CENTER.x + Math.sin(angle) * RADIUS;
  const y = CENTER.y - Math.cos(angle) * RADIUS;
  const side = Math.sin(angle) > 0.3 ? 'right' : Math.sin(angle) < -0.3 ? 'left' : Math.cos(angle) > 0 ? 'top' : 'bottom';
  const labelX = side === 'right' ? x + LABEL_GAP : side === 'left' ? x - LABEL_GAP : x;
  const labelY = side === 'top' ? y - TOP_GAP : side === 'bottom' ? y + LABEL_GAP : y;
  return {
    stage,
    x: Math.round(x * 10) / 10,
    y: Math.round(y * 10) / 10,
    side,
    style: `left: ${percent(labelX, WIDTH)}; top: ${percent(labelY, HEIGHT)}`,
    label: t(lang, `factory.node.${stage}` as UiKey),
  };
});
const messages = Object.fromEntries(FACTORY_STAGES.map((stage) => [stage, t(lang, `factory.stage.${stage}` as UiKey)]));
---
<section
  class="factory-loop"
  aria-labelledby="factory-heading"
  data-messages={JSON.stringify(messages)}
  data-origin={`${CENTER.x} ${CENTER.y}`}
  data-radius={RADIUS}
>
  <h2 id="factory-heading">{t(lang, 'factory.heading')}</h2>
  <p class="factory-intro factory-static-only">{t(lang, 'factory.introStatic')}</p>
  <p class="factory-intro factory-live-only">{t(lang, 'factory.intro')}</p>
  <div class="factory-board" transition:name={transitionName}>
    <div class="factory-diagram">
      <svg viewBox={`0 0 ${WIDTH} ${HEIGHT}`} aria-hidden="true" focusable="false">
        <circle class="factory-ring" cx={CENTER.x} cy={CENTER.y} r={RADIUS} />
        <circle class="factory-hub" data-stage="clean" cx={CENTER.x} cy={CENTER.y} r="46" />
        {nodes.map((node) => (
          <circle class:list={['factory-node', { 'is-factory': node.stage === 'factory' }]} data-stage={node.stage} cx={node.x} cy={node.y} r={node.stage === 'factory' ? 17 : 12} />
        ))}
        <g class="factory-arm">
          <rect class="factory-ticket" x={CENTER.x - 15} y={CENTER.y - RADIUS - 10} width="30" height="20" rx="5" />
        </g>
      </svg>
      {nodes.map((node) => node.stage === 'label' ? (
        <>
          <span class={`factory-label side-${node.side} factory-static-only`} data-stage={node.stage} style={node.style}>{node.label}</span>
          <button type="button" class={`factory-label factory-jira side-${node.side} factory-live-only`} data-stage={node.stage} style={node.style}>{node.label}</button>
        </>
      ) : (
        <span class={`factory-label side-${node.side}`} data-stage={node.stage} style={node.style}>{node.label}</span>
      ))}
      <span class="factory-label factory-hub-label" data-stage="clean" style={`left: 50%; top: ${percent(CENTER.y, HEIGHT)}`}>{t(lang, 'factory.hub')}</span>
    </div>
    <div class="factory-side">
      <ol class="factory-stages">
        {FACTORY_STAGES.map((stage) => <li data-stage={stage}>{messages[stage]}</li>)}
      </ol>
      <p class="factory-note">{t(lang, 'factory.loopNote')}</p>
      <div class="factory-controls factory-live-only">
        <button type="button" class="factory-run">{t(lang, 'factory.run')}</button>
        <p class="factory-status" aria-live="polite">{t(lang, 'factory.idle')}</p>
      </div>
    </div>
  </div>
</section>
<script>
  import { motionEnabled, onPage } from '../scripts/lifecycle';
  import { initFactoryLoop } from '../scripts/factory-loop';
  onPage(() => {
    const root = document.querySelector<HTMLElement>('.factory-loop');
    return root && motionEnabled() ? initFactoryLoop(root) : undefined;
  });
</script>
<style>
  .factory-loop { margin-block: 72px; scroll-margin-top: 88px }
  h2 { font-family: var(--font-display); font-weight: 700; font-size: clamp(24px, 3vw, 38px); letter-spacing: -.03em; line-height: 1.1; margin: 0 0 12px }
  .factory-intro { margin: 0 0 24px; color: var(--muted); max-width: 62ch }

  /* Static diagram by default (no JS, reduced motion); the script adds .is-live. */
  .factory-live-only { display: none }
  .factory-loop.is-live .factory-live-only { display: revert }
  .factory-loop.is-live .factory-controls { display: flex }
  .factory-loop.is-live .factory-static-only { display: none }

  .factory-board {
    display: grid; grid-template-columns: minmax(0, 1.25fr) minmax(0, 1fr); gap: 32px; align-items: center;
    background: var(--surface); border-radius: 28px; padding: clamp(16px, 3vw, 36px);
    box-shadow: 0 0 0 1px var(--line), 0 40px 80px -40px rgb(20 10 40 / .45);
  }
  .factory-diagram { position: relative; aspect-ratio: 560 / 440; min-width: 0 }
  svg { position: absolute; inset: 0; width: 100%; height: 100%; overflow: visible }
  .factory-ring { fill: none; stroke: var(--line); stroke-width: 3; stroke-dasharray: 2 8; stroke-linecap: round }
  .factory-hub { fill: var(--bg); stroke: var(--line); stroke-width: 2; transition: fill .3s }
  .factory-node { fill: var(--bg); stroke: var(--muted); stroke-width: 2; transition: fill .3s, stroke .3s }
  .factory-node.is-factory { stroke: var(--accent) }
  .factory-node.is-active, .factory-hub.is-active { fill: var(--accent); stroke: var(--accent) }
  .factory-ticket { fill: var(--accent); stroke: var(--surface); stroke-width: 3 }
  .factory-loop:not(.is-live) .factory-arm { display: none }

  .factory-label {
    position: absolute; max-width: 26%; font: 500 12px/1.25 var(--font-mono); color: var(--ink);
    transform: translate(-50%, -50%); text-align: center; transition: color .3s;
  }
  .factory-label.side-right { transform: translate(0, -50%); text-align: left }
  .factory-label.side-left { transform: translate(-100%, -50%); text-align: right }
  .factory-label.is-active { color: var(--accent-ink) }
  .factory-hub-label { color: var(--muted); max-width: 16% }
  .factory-hub-label.is-active { color: var(--on-accent) }
  .factory-jira {
    min-height: 40px; padding: 6px 14px; border-radius: 999px; cursor: pointer; max-width: none; white-space: nowrap;
    border: 1px solid var(--accent); background: var(--surface); color: var(--ink); font: inherit; font: 500 12px/1.2 var(--font-mono);
  }
  .factory-jira:hover:not([aria-disabled="true"]) { background: var(--accent); color: var(--on-accent) }
  .factory-jira.is-active { color: var(--on-accent); background: var(--accent) }

  .factory-side { display: grid; gap: 16px; min-width: 0 }
  .factory-stages { margin: 0; padding-left: 1.6em; display: grid; gap: 6px; font-size: 15px; line-height: 1.45; color: var(--muted) }
  .factory-stages li { transition: color .3s }
  .factory-stages li::marker { font: 500 13px var(--font-mono) }
  .factory-stages li.is-active { color: var(--ink); font-weight: 600 }
  .factory-stages li.is-active::marker { color: var(--accent-ink) }
  .factory-note { margin: 0; font: 13px/1.5 var(--font-mono); color: var(--muted) }

  .factory-controls { display: none; flex-wrap: wrap; align-items: center; gap: 12px 16px }
  .factory-run {
    min-height: 44px; min-width: 96px; padding: 10px 22px; border-radius: 999px; cursor: pointer; border: 0;
    background: var(--accent); color: var(--on-accent); font: 600 15px/1 var(--font-body);
  }
  .factory-run[aria-disabled="true"], .factory-jira[aria-disabled="true"] { cursor: progress; opacity: .55 }
  .factory-status { margin: 0; font: 500 13px/1.4 var(--font-mono); color: var(--ink); flex: 1 1 14em }
  .factory-loop.is-clean .factory-status { color: var(--accent-ink) }

  @media (max-width: 860px) {
    .factory-loop { margin-block: 48px }
    .factory-board { grid-template-columns: minmax(0, 1fr); gap: 20px; border-radius: 22px }
    .factory-label { font-size: 11px }
  }
  @media (prefers-reduced-motion: reduce) {
    .factory-node, .factory-hub, .factory-label, .factory-stages li { transition: none }
  }
</style>
