---
import { t, type Lang } from '../i18n/utils';
interface Props { lang: Lang }
const { lang } = Astro.props;
/** Each letter's place in the name; the rise-in staggers by it. */
let letterIndex = 0;
const lines = ['Łukasz', 'Moszczyński'].map((line) => [...line]);
/** The eyebrow wraps only between its parts, never inside a job title. */
const eyebrowParts = t(lang, 'hero.eyebrow').split(' · ');
---
<section class="hero" id="top">
  <div class="wrap">
    <p class="eyebrow"><span>{eyebrowParts.map((part, index) => <>{index > 0 && ' · '}<span class="eyebrow-part">{part}</span></>)}</span></p>
    <h1 class="name" aria-label="Łukasz Moszczyński">
      {lines.map((letters) => (
        <span class="line" aria-hidden="true">{letters.map((letter) => <span class="char" style={`--i: ${letterIndex++}`}>{letter}</span>)}</span>
      ))}
    </h1>
    <div class="hero-foot">
      <p class="claim" set:html={t(lang, 'hero.claim')} />
      <div class="sub-wrap">
        <p class="sub">{t(lang, 'hero.sub')}</p>
        <p class="grid-hint">{t(lang, 'hero.gridHint')}</p>
      </div>
    </div>
  </div>
</section>
<script>
  import { onPage } from '../scripts/lifecycle';
  import { initHero } from '../scripts/name-weight';
  onPage(() => {
    const root = document.querySelector<HTMLElement>('.hero');
    return root ? initHero(root) : undefined;
  });
</script>
<style is:global>
  .hero { position: relative; padding-block: 150px 90px; overflow: hidden; isolation: isolate }
  .eyebrow { font-family: var(--font-body); font-weight: 600; font-size: 14px; color: var(--muted); margin: 0 0 22px; display: flex; gap: 10px; align-items: center }
  .eyebrow-part { white-space: nowrap }
  .eyebrow::before { content: ""; flex: none; width: 8px; height: 8px; border-radius: 50%; background: var(--accent); box-shadow: 0 0 0 5px color-mix(in srgb, var(--accent) 25%, transparent) }
  .name { font-family: var(--font-display); font-weight: 300; font-size: clamp(36px, 8.6vw, 150px); line-height: .98; letter-spacing: -.02em; margin: 0; cursor: default; contain: layout }
  .name .line { display: block; overflow: hidden; padding-bottom: .08em; white-space: nowrap }
  .name .line + .line { color: var(--accent-display) }
  .char { display: inline-block }
  /*
   * Rise-in: plain CSS, so it starts with the first paint instead of waiting for the scripts (on a slow
   * phone that wait made the page look unfinished for seconds). `fill-mode: backwards` holds the start pose
   * during the delay, so the name never flashes in full; once done, the animation leaves no trace. Skipped after a language switch: the class is
   * on <html> while the new page is swapped in, and name-weight.ts marks the hero `still` before it goes.
   */
  html.motion:not(.quiet-arrival) .hero:not(.still) .char { animation: hero-char-rise 1.2s var(--ease-expo-out) calc(.4s + var(--i) * 35ms) backwards }
  html.motion:not(.quiet-arrival) .hero:not(.still) :is(.eyebrow, .claim, .sub, .grid-hint) { animation: hero-reveal 1s var(--ease-expo-out) .8s backwards }
  html.motion:not(.quiet-arrival) .hero:not(.still) .claim { animation-delay: .88s }
  html.motion:not(.quiet-arrival) .hero:not(.still) .sub { animation-delay: .96s }
  html.motion:not(.quiet-arrival) .hero:not(.still) .grid-hint { animation-delay: 1.04s }
  .hero { --ease-expo-out: cubic-bezier(.19, 1, .22, 1) }
  @keyframes hero-char-rise { from { transform: translateY(120%) rotate(10deg) } to { transform: none } }
  @keyframes hero-reveal { from { opacity: 0; transform: translateY(18px) } to { opacity: 1; transform: none } }
  .hero-foot { display: flex; flex-wrap: wrap; justify-content: space-between; align-items: end; gap: 24px; margin-top: 32px }
  /* Bold, so it counts as large text from 18.7px and its orange part can use the display orange. */
  .claim { font-family: var(--font-display); font-weight: 700; font-size: clamp(20px, 2.4vw, 30px); line-height: 1.2; letter-spacing: -.02em; margin: 0; max-width: 20ch }
  .claim em { font-style: normal; color: var(--accent-display) }
  .sub-wrap { display: grid; gap: 10px }
  .sub { max-width: 40ch; color: var(--muted); margin: 0 }
  .grid-hint { font-family: var(--font-mono); font-size: 13px; color: var(--accent-ink); margin: 0 }
</style>
