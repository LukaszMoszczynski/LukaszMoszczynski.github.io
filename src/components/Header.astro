---
import { localizePath, t, type Lang } from '../i18n/utils';
import LangSwitch from './LangSwitch.astro';
import ThemeToggle from './ThemeToggle.astro';
interface Props { lang: Lang }
const { lang } = Astro.props;
const home = localizePath('/', lang);
---
<header class="bar">
  <a class="logo" href={home} aria-label={t(lang, 'nav.logoLabel')}>ŁM<span>.</span></a>
  <nav>
    <a class="nav-link" href={`${home}#work`}>{t(lang, 'nav.work')}</a>
    <a class="nav-link" href={`${home}#contact`}>{t(lang, 'nav.contact')}</a>
    <LangSwitch lang={lang} />
    <ThemeToggle lang={lang} />
  </nav>
</header>
<style is:global>
  .bar {
    position: fixed; top: env(safe-area-inset-top, 0px); left: 0; right: 0; z-index: 20;
    display: flex; justify-content: space-between; align-items: center; gap: 16px;
    padding-block: 16px;
    padding-left: max(16px, env(safe-area-inset-left, 0px));
    padding-right: max(16px, env(safe-area-inset-right, 0px));
    pointer-events: none;
  }
  .bar > * { pointer-events: auto }
  .logo { font-family: var(--font-display); font-weight: 800; font-size: 18px; text-decoration: none; letter-spacing: -.02em }
  .logo span { color: var(--accent) }
  .bar nav {
    display: flex; gap: 4px; padding: 6px; border-radius: 999px;
    background: color-mix(in srgb, var(--surface) 70%, transparent);
    backdrop-filter: blur(14px); box-shadow: 0 0 0 1px var(--line);
  }
  .bar nav a, .bar nav button {
    font: 600 13px/1 var(--font-body); border: 0; background: transparent; color: var(--ink);
    border-radius: 999px; padding: 9px 14px; cursor: pointer; text-decoration: none;
  }
  .bar nav a:hover, .bar nav button:hover { background: var(--line) }
  @media (max-width: 640px) { .bar nav .nav-link { display: none } }
</style>
