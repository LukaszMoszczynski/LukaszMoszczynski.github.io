---
import { t, type Lang } from '../i18n/utils';
interface Props { lang: Lang }
const { lang } = Astro.props;

// Real LinkedIn recommendations; they stay in the English original on every language.
const quotes = [
  { text: "“Łukasz combines strong technical expertise with excellent leadership skills. He knows how to bring people together, share knowledge, solve complex challenges, and drive projects forward… actively introducing and integrating AI into our workflows.”", name: 'Sylwia Wochniak', role: 'Senior Frontend Developer · home.pl, 2026' },
  { text: "“Łukasz demonstrated a superb understanding of frontend technologies and the ability to create innovative solutions. His programming skills are impeccable.”", name: 'Aleksandra Zalewska', role: 'Senior Frontend Developer · home.pl, 2023' },
  { text: "“I was impressed with Łukasz's attention to detail, professionalism, and ability to deliver high-quality code within tight deadlines.”", name: 'Szymon Papis', role: 'Software Developer · 2023' },
  { text: "“He's also a fast learner and by over two years of our collaboration, he made huge progress… an awesome person with super positive vibes who you simply cannot dislike.”", name: 'Dawid Krajewski', role: 'Co-Founder @ Sherlo (formerly home.pl) · 2022' },
];
---
<section class="reco wrap" id="recommendations" aria-labelledby="reco-heading">
  <div class="reco-copy">
    <p class="reco-kicker">{t(lang, 'reco.kicker')}</p>
    <h2 id="reco-heading">{t(lang, 'reco.heading')}</h2>
    <p class="reco-hint" data-reduced={t(lang, 'reco.hintReduced')}>{t(lang, 'reco.hint')}</p>
    <div class="deck-controls">
      <button type="button" class="deck-btn prev-quote fx-pill" aria-controls="reco-deck">{t(lang, 'reco.prev')}</button>
      <button type="button" class="deck-btn next-quote fx-pill" aria-controls="reco-deck">{t(lang, 'reco.next')}</button>
    </div>
    <p class="deck-announce" aria-live="polite" aria-atomic="true" data-template={t(lang, 'reco.position')}></p>
  </div>
  <div class="deck" id="reco-deck" role="region" aria-label={t(lang, 'reco.kicker')}>
    {quotes.map((quote) => (
      <figure class="quote">
        <blockquote lang="en">{quote.text}</blockquote>
        <figcaption><b>{quote.name}</b><span>{quote.role}</span></figcaption>
      </figure>
    ))}
  </div>
</section>
<script>
  import { onPage } from '../scripts/lifecycle';
  import { initDeck } from '../scripts/deck';
  onPage(() => {
    const root = document.querySelector<HTMLElement>('#recommendations');
    return root ? initDeck(root) : undefined;
  });
</script>
<style is:global>
  .reco { padding-block: 40px 120px; display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1.2fr); gap: 48px; align-items: center; overflow-x: clip }
  .reco-kicker { font-family: var(--font-mono); font-size: 13px; color: var(--accent-ink); margin: 0 0 12px }
  .reco h2 { font-family: var(--font-display); font-weight: 700; font-size: clamp(28px, 4vw, 54px); letter-spacing: -.035em; line-height: 1.05; margin: 0 0 16px; text-wrap: balance }
  .reco-hint { color: var(--muted); margin: 0 }
  .reco .deck-controls { display: none }
  .reco .deck-announce { position: absolute; width: 1px; height: 1px; overflow: hidden; clip-path: inset(50%); white-space: nowrap; margin: 0 }
  /* html.init-pending: the deck is drawn collapsed before deck.ts runs, so init does not shift the page. */
  .reco.deck-on .deck-controls, html.init-pending .reco .deck-controls { display: flex; flex-wrap: wrap; gap: 10px; margin-top: 22px }
  .reco .deck-btn { display: inline-flex; align-items: center; min-height: 48px; font: 600 14px/1 var(--font-body); padding: 0 24px; border-radius: 999px; border: 0; cursor: pointer }
  .reco .next-quote { background: var(--accent); color: var(--on-accent); --fx-fill: var(--ink); --fx-ink: var(--bg) }
  .reco .prev-quote { background: transparent; color: var(--ink); box-shadow: inset 0 0 0 1.5px var(--control-line); --fx-fill: var(--ink); --fx-ink: var(--bg) }
  /* Focus: the site's accent ring, kept round; on the deck it frames the visible card. */
  .reco .deck-btn:focus-visible { outline: 2px solid var(--focus-ring); outline-offset: 3px; border-radius: 999px }
  .reco.deck-on .deck:focus-visible { outline: 2px solid var(--focus-ring); outline-offset: 8px; border-radius: 32px }
  html:not(.init-pending) .reco:not(.deck-on) .reco-hint { display: none }
  .reco .deck { display: grid; gap: 20px; width: 100%; max-width: 560px; min-width: 0 }
  .reco.deck-on .deck, html.init-pending .reco .deck { gap: 0; padding-bottom: 40px; touch-action: pan-y }
  .reco .quote { margin: 0; padding: clamp(22px, 3vw, 34px); border-radius: 28px; background: var(--surface); box-shadow: 0 0 0 1px var(--line), 0 30px 60px -30px rgb(20 10 40 / .5); display: grid; align-content: space-between; gap: 18px; min-width: 0 }
  .reco.deck-on .quote, html.init-pending .reco .quote { grid-area: 1 / 1; cursor: grab; touch-action: pan-y; user-select: none }
  .reco.deck-on .quote:active { cursor: grabbing }
  .reco.deck-still .quote { cursor: default; touch-action: auto }
  /* Matches cardPose() in deck-model.ts for a deck of three. */
  html.init-pending .reco .quote:nth-child(1) { z-index: 3 }
  html.init-pending .reco .quote:nth-child(2) { z-index: 2; transform: translateY(16px) rotate(-3deg) scale(.95) }
  html.init-pending .reco .quote:nth-child(3) { z-index: 1; transform: translateY(32px) rotate(3deg) scale(.9) }
  .reco .quote blockquote { margin: 0; font-family: var(--font-display); font-weight: 500; font-size: clamp(17px, 1.8vw, 22px); line-height: 1.35; letter-spacing: -.01em }
  .reco .quote figcaption { display: grid; gap: 2px }
  .reco .quote figcaption span { color: var(--muted); font-size: 14px }
  @media (max-width: 860px) { .reco { grid-template-columns: minmax(0, 1fr); padding-block: 12px 72px; gap: 32px } }
</style>
