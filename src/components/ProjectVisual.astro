---
import type { Project } from '../content/projects';
import { t, type Lang } from '../i18n/utils';
interface Props { visual: Project['visual']; compact?: boolean; lang?: Lang; transitionName?: string }
const { visual, compact = false, lang = 'en', transitionName } = Astro.props;

/** Delivery loop: five stations on a ring, ticket between the agents and GitLab. */
const LOOP = [t(lang, 'visual.jira'), t(lang, 'visual.factory'), t(lang, 'visual.gitlab'), t(lang, 'visual.review'), t(lang, 'visual.fix')];
const loopNodes = LOOP.map((label, index) => {
  const angle = -Math.PI / 2 + (index * 2 * Math.PI) / LOOP.length;
  return { label, x: 200 + Math.cos(angle) * 100, y: 150 + Math.sin(angle) * 100, anchor: Math.cos(angle) > 0.3 ? 'start' : Math.cos(angle) < -0.3 ? 'end' : 'middle' };
});
const round = (value: number) => Math.round(value * 10) / 10;
---
<div class:list={['project-visual', { 'is-compact': compact }]} aria-hidden="true" transition:name={transitionName}>
  <div class={`project-screen v-${visual}`}>
    {visual === 'dcc' && (
      <>
        <span class="shape soft" style="inset: 7% 7% 86% 7%"></span>
        <span class="shape" style="inset: 20% 46% 66% 7%"></span>
        <span class="shape" style="inset: 37% 60% 58% 7%; opacity: .6"></span>
        <span class="shape accent pill" style="inset: 47% 72% 45% 7%"></span>
        <span class="shape card" style="inset: 62% 66% 8% 7%"><i></i></span>
        <span class="shape card" style="inset: 62% 37% 8% 36%"><i></i></span>
        <span class="shape card" style="inset: 62% 8% 8% 65%"><i></i></span>
        <span class="ticket" style="inset: 18% 8% 54% 60%"><b>PDF</b></span>
      </>
    )}
    {visual === 'design-system' && (
      <>
        <span class="shape swatch dark" style="inset: 10% 74% 68% 8%"></span>
        <span class="shape swatch" style="inset: 10% 52% 68% 30%"></span>
        <span class="shape swatch ink" style="inset: 10% 30% 68% 52%"></span>
        <span class="shape swatch violet" style="inset: 10% 8% 68% 74%"></span>
        <span class="shape pill" style="inset: 42% 52% 46% 8%"></span>
        <span class="shape dark pill" style="inset: 42% 8% 46% 54%"></span>
        <span class="shape" style="inset: 64% 8% 10% 8%; opacity: .7"></span>
        <span class="shape dark" style="inset: 72% 60% 18% 14%"></span>
        {!compact && <span class="label" style="left: 8%; top: 3%">{t(lang, 'visual.tokens')}</span>}
      </>
    )}
    {visual === 'qa-agent' && (
      <>
        <span class="shot" style="inset: 9% 53% 34% 7%"><i style="inset: 10% 12% 78% 12%"></i><i style="inset: 30% 12% 40% 12%"></i><i style="inset: 70% 40% 12% 12%"></i></span>
        <span class="shot" style="inset: 9% 7% 34% 53%"><i style="inset: 10% 12% 78% 12%"></i><i style="inset: 30% 12% 40% 12%"></i><i style="inset: 70% 40% 12% 12%"></i><em style="inset: 26% 6% 36% 6%"></em></span>
        <span class="check" style="inset: 72% 40% 21% 7%"></span>
        <span class="check" style="inset: 81% 52% 12% 7%"></span>
        <span class="check warn" style="inset: 72% 7% 12% 64%"></span>
        {!compact && (
          <>
            <span class="label" style="left: 7%; top: 2%">{t(lang, 'visual.master')}</span>
            <span class="label" style="left: 53%; top: 2%">{t(lang, 'visual.branch')}</span>
          </>
        )}
      </>
    )}
    {visual === 'delivery-loop' && (
      <svg class="loop" viewBox="0 0 400 300" preserveAspectRatio="xMidYMid meet">
        <circle cx="200" cy="150" r="100" class="ring" />
        <circle cx="200" cy="150" r="100" class="ring-run" pathLength="100" />
        {loopNodes.map((node, index) => (
          <g>
            <circle cx={round(node.x)} cy={round(node.y)} r={index === 1 ? 17 : 12} class:list={['node', { factory: index === 1 }]} />
            {!compact && (
              <text x={round(node.x + (node.anchor === 'start' ? 24 : node.anchor === 'end' ? -24 : 0))} y={round(node.y + (node.anchor === 'middle' ? -24 : 4))} text-anchor={node.anchor}>{node.label}</text>
            )}
          </g>
        ))}
        <rect x="270" y="168" width="26" height="18" rx="4" class="ticket-chip" transform="rotate(-20 283 177)" />
        {!compact && <text x="200" y="154" text-anchor="middle" class="center">{t(lang, 'visual.human')}</text>}
      </svg>
    )}
    {visual === 'wp-starter' && (
      <>
        <span class="frame" style="inset: 12% 58% 12% 7%"><i style="inset: 6% 8% 70% 8%"></i><i class="accent" style="inset: 36% 8% 40% 8%"></i><i style="inset: 66% 8% 6% 8%"></i></span>
        <svg class="arrow" viewBox="0 0 400 300" preserveAspectRatio="none"><path d="M176 150 H222" /><path d="M212 140 L224 150 L212 160" /></svg>
        <span class="shape page" style="inset: 12% 7% 12% 58%"><i style="inset: 6% 8% 70% 8%"></i><i class="accent" style="inset: 36% 8% 40% 8%"></i><i style="inset: 66% 8% 6% 8%"></i></span>
        {!compact && (
          <>
            <span class="label" style="left: 7%; top: 3%">Figma</span>
            <span class="label" style="left: 58%; top: 3%">WordPress</span>
          </>
        )}
      </>
    )}
    {visual === 'omelanski' && (
      <>
        <svg class="lines" viewBox="0 0 400 300" preserveAspectRatio="none">
          <path d="M150 66 C200 66 200 150 244 150" />
          <path d="M150 150 H244" />
          <path d="M150 234 C200 234 200 150 244 150" />
        </svg>
        <span class="shape pill domain" style="inset: 17% 63% 72% 7%">{!compact && <b>www</b>}</span>
        <span class="shape pill domain" style="inset: 45% 63% 45% 7%; opacity: .8">{!compact && <b>.com</b>}</span>
        <span class="shape pill domain" style="inset: 73% 63% 17% 7%; opacity: .65">{!compact && <b>{t(lang, 'visual.old')}</b>}</span>
        <span class="shape page" style="inset: 14% 7% 14% 61%"><i class="dark" style="inset: 6% 8% 78% 8%"></i><i class="accent" style="inset: 28% 30% 52% 8%"></i><i style="inset: 54% 8% 34% 8%"></i><i style="inset: 70% 26% 20% 8%"></i></span>
      </>
    )}
  </div>
</div>
<style>
  .project-visual { perspective: 900px }
  .project-screen {
    aspect-ratio: 4 / 3; max-width: 100%; border-radius: 20px; position: relative; overflow: hidden;
    transform-style: preserve-3d; box-shadow: inset 0 0 0 1px rgb(255 255 255 / .08);
    --white: rgb(255 255 255 / .92); --night: #1a1230; --brand: #372662; --orange: #eb6126; --purple: #7b5bd6;
  }
  .v-dcc { background: linear-gradient(135deg, #372662, #5b3fa8) }
  .v-design-system { background: linear-gradient(135deg, #eb6126, #c2410c) }
  .v-qa-agent { background: linear-gradient(135deg, #1a1230, #2a1d4d) }
  .v-delivery-loop { background: radial-gradient(circle at 50% 50%, #372662, #1a1230 70%) }
  .v-wp-starter { background: linear-gradient(135deg, #1a1230, #372662) }
  .v-omelanski { background: linear-gradient(135deg, #5b3fa8, #eb6126) }

  .shape, .shot, .frame, .check, .ticket { position: absolute; border-radius: 10px; background: var(--white) }
  .shape i, .shot i, .shot em, .frame i { position: absolute; border-radius: 4px; background: rgb(42 29 77 / .14) }
  .soft { opacity: .25 }
  .pill { border-radius: 999px }
  .accent { background: var(--orange) !important }
  .dark { background: var(--night) }
  .ink { background: var(--brand) }
  .violet { background: var(--purple) }
  .card i { inset: 66% 12% 12% 56%; border-radius: 999px; background: var(--orange) }
  .swatch { border-radius: 14px }

  .ticket {
    background: var(--orange); border-radius: 12px; transform: rotate(-6deg);
    box-shadow: 0 18px 30px -12px rgb(0 0 0 / .45);
    -webkit-mask: radial-gradient(circle at 0 50%, transparent 9px, #000 10px) left / 51% 100% no-repeat,
      radial-gradient(circle at 100% 50%, transparent 9px, #000 10px) right / 51% 100% no-repeat;
    mask: radial-gradient(circle at 0 50%, transparent 9px, #000 10px) left / 51% 100% no-repeat,
      radial-gradient(circle at 100% 50%, transparent 9px, #000 10px) right / 51% 100% no-repeat;
    display: grid; place-items: center;
  }
  .ticket b { font: 600 12px/1 var(--font-mono); color: #fff; letter-spacing: .08em }

  .shot { background: rgb(255 255 255 / .9) }
  .shot em { background: transparent; border: 2px dashed var(--orange); border-radius: 6px }
  .check { border-radius: 999px; background: rgb(255 255 255 / .22) }
  .check::before { content: ""; position: absolute; left: 6px; top: 50%; width: 10px; height: 10px; margin-top: -5px; border-radius: 50%; background: #fff }
  .check.warn::before { background: var(--orange) }

  .frame { background: transparent; border: 2px dashed #5aa7e6; border-radius: 6px }
  .frame i { background: rgb(255 255 255 / .22) }
  .page { background: var(--white) }

  .domain { display: grid; place-items: center }
  .domain b { font: 600 11px/1 var(--font-mono); color: var(--brand) }

  .label { position: absolute; font: 500 11px/1 var(--font-mono); color: rgb(255 255 255 / .75); letter-spacing: .04em }

  svg { position: absolute; inset: 0; width: 100%; height: 100% }
  .arrow path, .lines path { fill: none; stroke: rgb(255 255 255 / .7); stroke-width: 3; stroke-linecap: round; stroke-linejoin: round; vector-effect: non-scaling-stroke }
  .lines path { stroke-dasharray: 4 6 }
  .ring { fill: none; stroke: rgb(255 255 255 / .2); stroke-width: 2 }
  .ring-run { fill: none; stroke: var(--orange); stroke-width: 3; stroke-linecap: round; stroke-dasharray: 22 78; transform: rotate(-90deg); transform-origin: 200px 150px }
  .node { fill: #f4f0fb }
  .node.factory { fill: var(--orange) }
  .ticket-chip { fill: #fff; stroke: var(--orange); stroke-width: 2 }
  .loop text { font: 500 13px var(--font-mono); fill: rgb(255 255 255 / .8) }
  .loop .center { font-size: 12px; fill: rgb(255 255 255 / .55) }
</style>
