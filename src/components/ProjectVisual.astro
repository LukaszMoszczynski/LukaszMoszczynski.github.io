---
import type { Project } from '../content/projects';
import { t, type Lang } from '../i18n/utils';
import LoopDiagram from './LoopDiagram.astro';
interface Props { visual: Project['visual']; compact?: boolean; lang?: Lang; transitionName?: string }
const { visual, compact = false, lang = 'en', transitionName } = Astro.props;
---
<div class:list={['project-visual', { 'is-compact': compact }]} data-visual={visual} aria-hidden="true" transition:name={transitionName}>
  <div class={`project-screen v-${visual}`}>
    {visual === 'dcc' && (
      <>
        <span class="shape soft" style="inset: 7% 7% 86% 7%"></span>
        <span class="shape" style="inset: 20% 46% 66% 7%"></span>
        <span class="shape" style="inset: 37% 60% 58% 7%; opacity: .6"></span>
        <span class="shape accent pill dcc-buy" style="inset: 47% 72% 45% 7%"></span>
        <span class="dcc-pay" style="inset: 49.5% 40% 47.5% 32%"><i class="dcc-pay-fill"></i></span>
        <span class="shape card dcc-card" style="inset: 62% 66% 8% 7%"><i></i></span>
        <span class="shape card dcc-card" style="inset: 62% 37% 8% 36%"><i></i></span>
        <span class="shape card dcc-card" style="inset: 62% 8% 8% 65%"><i></i></span>
        <span class="ticket dcc-voucher" style="inset: 18% 8% 54% 60%"><b>PDF</b></span>
      </>
    )}
    {visual === 'design-system' && (
      <>
        <span class="ds-brand"></span>
        <span class="shape swatch dark" style="inset: 10% 74% 68% 8%"></span>
        <span class="shape swatch" style="inset: 10% 52% 68% 30%"></span>
        <span class="shape swatch ink" style="inset: 10% 30% 68% 52%"></span>
        <span class="shape swatch violet" style="inset: 10% 8% 68% 74%"></span>
        <b class="ds-drop" style="left: 26%; top: 45.3%" data-from="275 -506"></b>
        <b class="ds-drop ink" style="left: 71%; top: 45.3%" data-from="-300 -506"></b>
        <span class="shape pill ds-atom-pill" style="inset: 42% 52% 46% 8%"></span>
        <span class="shape dark pill ds-atom-pill" style="inset: 42% 8% 46% 54%"></span>
        <span class="ds-page" style="inset: 60% 4% 5% 4%"></span>
        <span class="shape ds-card" style="inset: 64% 8% 10% 8%"><i class="ds-atom dark" style="inset: 30.8% 61.9% 30.8% 7.1%"></i><i class="ds-atom accent" style="inset: 36% 34% 36% 44%"></i></span>
        {!compact && <span class="label" style="left: 8%; top: 3%">{t(lang, 'visual.tokens')}</span>}
      </>
    )}
    {visual === 'qa-agent' && (
      <>
        <span class="shot" style="inset: 9% 53% 34% 7%"><i style="inset: 10% 12% 78% 12%"></i><i style="inset: 30% 12% 40% 12%"></i><i style="inset: 70% 40% 12% 12%"></i><b class="qa-scan"></b></span>
        <span class="shot" style="inset: 9% 7% 34% 53%"><i style="inset: 10% 12% 78% 12%"></i><i class="qa-changed" style="inset: 30% 30% 40% 12%"></i><i style="inset: 70% 40% 12% 12%"></i><em class="qa-box" style="inset: 26% 6% 36% 6%"></em><b class="qa-scan"></b></span>
        <span class="check qa-row" style="inset: 72% 40% 21% 7%"><b class="qa-fill"></b><b class="qa-dot">✓</b></span>
        <span class="check qa-row" style="inset: 81% 52% 12% 7%"><b class="qa-fill"></b><b class="qa-dot warn">!</b></span>
        <span class="check qa-mr" style="inset: 72% 7% 12% 64%"><b class="qa-fill"></b><b class="qa-mr-label">{t(lang, 'visual.oneDiff')}</b></span>
        {!compact && (
          <>
            <span class="label" style="left: 7%; top: 2%">{t(lang, 'visual.master')}</span>
            <span class="label" style="left: 53%; top: 2%">{t(lang, 'visual.branch')}</span>
          </>
        )}
      </>
    )}
    {visual === 'delivery-loop' && (
      <div class="loop-board"><LoopDiagram ticketAt="hub" lit compact /></div>
    )}
    {visual === 'wp-starter' && (
      <>
        <span class="frame" style="inset: 12% 58% 12% 7%"><i class="wp-source" style="inset: 6% 8% 70% 8%"></i><i class="wp-source accent" style="inset: 36% 8% 40% 8%"></i><i class="wp-source" style="inset: 66% 8% 6% 8%"></i></span>
        <svg class="arrow" viewBox="0 0 400 300" preserveAspectRatio="none"><path d="M176 150 H222" /><path d="M212 140 L224 150 L212 160" /></svg>
        <span class="shape page" style="inset: 12% 7% 12% 58%"><i class="wp-block" style="inset: 6% 8% 70% 8%"><b class="wp-skin"></b></i><i class="wp-block accent" style="inset: 36% 8% 40% 8%"><b class="wp-skin"></b></i><i class="wp-block" style="inset: 66% 8% 6% 8%"><b class="wp-skin"></b></i></span>
        {!compact && (
          <>
            <span class="label" style="left: 7%; top: 3%">Figma</span>
            <span class="label" style="left: 58%; top: 3%">WordPress</span>
          </>
        )}
      </>
    )}
    {visual === 'omelanski' && (
      <>
        <svg class="lines" viewBox="0 0 400 300" preserveAspectRatio="none">
          <path d="M150 66 C200 66 200 150 244 150" />
          <path d="M150 150 H244" />
          <path d="M150 234 C200 234 200 150 244 150" />
          <path class="om-packet" pathLength="100" d="M150 66 C200 66 200 150 244 150" />
          <path class="om-packet" pathLength="100" d="M150 150 H244" />
          <path class="om-packet" pathLength="100" d="M150 234 C200 234 200 150 244 150" />
        </svg>
        <span class="shape pill domain" style="inset: 17% 63% 72% 7%">{!compact && <b>www</b>}</span>
        <span class="shape pill domain" style="inset: 45% 63% 45% 7%; opacity: .8">{!compact && <b>.com</b>}</span>
        <span class="shape pill domain" style="inset: 73% 63% 17% 7%; opacity: .65">{!compact && <b>{t(lang, 'visual.old')}</b>}</span>
        <span class="om-301" style="left: 50%; top: 70%">301</span>
        <span class="shape page" style="inset: 14% 7% 14% 61%"><i class="om-block dark" style="inset: 6% 8% 78% 8%"></i><i class="om-block accent" style="inset: 28% 30% 52% 8%"></i><i class="om-block" style="inset: 54% 8% 34% 8%"></i><i class="om-block" style="inset: 70% 26% 20% 8%"></i></span>
      </>
    )}
  </div>
</div>
<style>
  .project-visual { perspective: 900px }
  .project-screen {
    aspect-ratio: 4 / 3; max-width: 100%; border-radius: 20px; position: relative; overflow: hidden; container-type: inline-size;
    transform-style: preserve-3d; box-shadow: inset 0 0 0 1px rgb(255 255 255 / .08);
    --white: rgb(255 255 255 / .92); --night: #1a1230; --brand: #372662; --orange: #eb6126; --purple: #7b5bd6;
  }
  .v-dcc { background: linear-gradient(135deg, #372662, #5b3fa8) }
  .v-design-system { background: linear-gradient(135deg, #eb6126, #c2410c) }
  .v-qa-agent { background: linear-gradient(135deg, #1a1230, #2a1d4d) }
  /* Delivery loop: a compact copy of the board on the case page (LoopDiagram.astro), in the board's own colours. */
  .v-delivery-loop { background: var(--surface); box-shadow: inset 0 0 0 1px var(--line) }
  .loop-board { position: absolute; inset: 8% }
  .v-wp-starter { background: linear-gradient(135deg, #1a1230, #372662) }
  .v-omelanski { background: linear-gradient(135deg, #5b3fa8, #eb6126) }

  .shape, .shot, .frame, .check, .ticket { position: absolute; border-radius: 10px; background: var(--white) }
  .shape i, .shot i, .shot em, .frame i { position: absolute; border-radius: 4px; background: rgb(42 29 77 / .14) }
  .soft { opacity: .25 }
  .pill { border-radius: 999px }
  .accent { background: var(--orange) !important }
  .dark { background: var(--night) }
  .ink { background: var(--brand) }
  .violet { background: var(--purple) }
  .card i { inset: 66% 12% 12% 56%; border-radius: 999px; background: var(--orange) }
  .swatch { border-radius: 14px }
  /* Design system: the second brand washes over once per loop; at rest the page is the orange brand. */
  .ds-brand { position: absolute; inset: 0; background: linear-gradient(135deg, #7b5bd6, #372662); opacity: 0 }
  .ds-drop { position: absolute; width: 4%; aspect-ratio: 1; border-radius: 50%; background: var(--white); opacity: 0 }
  .ds-drop.ink { background: var(--brand) }
  .ds-page { position: absolute; border: 2px solid rgb(255 255 255 / .55); border-radius: 16px }
  .ds-card { background: rgb(255 255 255 / .75) }
  .ds-card .ds-atom.dark { background: var(--night) }
  .ds-card .ds-atom.accent { border-radius: 999px }

  .ticket {
    background: var(--orange); border-radius: 12px; transform: rotate(-6deg);
    box-shadow: 0 18px 30px -12px rgb(0 0 0 / .45);
    -webkit-mask: radial-gradient(circle at 0 50%, transparent 9px, #000 10px) left / 51% 100% no-repeat,
      radial-gradient(circle at 100% 50%, transparent 9px, #000 10px) right / 51% 100% no-repeat;
    mask: radial-gradient(circle at 0 50%, transparent 9px, #000 10px) left / 51% 100% no-repeat,
      radial-gradient(circle at 100% 50%, transparent 9px, #000 10px) right / 51% 100% no-repeat;
    display: grid; place-items: center;
  }
  .ticket b { font: 600 12px/1 var(--font-mono); color: var(--night); letter-spacing: .08em }
  /* DCC: the payment bar between the buy button and the cards; full at rest (the order is paid). */
  .dcc-pay { position: absolute; border-radius: 999px; background: rgb(255 255 255 / .22); overflow: hidden }
  .dcc-pay-fill { position: absolute; inset: 0; border-radius: inherit; background: var(--white); transform-origin: 0 50% }

  .shot { background: rgb(255 255 255 / .9); overflow: hidden }
  .shot em { background: transparent; border: 2px dashed var(--orange); border-radius: 6px }
  .shot .qa-changed { background: rgb(235 97 38 / .3) }
  /* The scan line sits at the bottom edge of a full-height layer that slides down the shot. */
  .qa-scan {
    position: absolute; inset: 0; opacity: 0; pointer-events: none;
    background: linear-gradient(to bottom, rgb(123 91 214 / 0) 55%, rgb(123 91 214 / .22) calc(100% - 2px), var(--purple) calc(100% - 2px));
  }
  .check { border-radius: 999px; background: rgb(255 255 255 / .22); overflow: hidden }
  .qa-fill { position: absolute; inset: 0; border-radius: inherit; background: rgb(255 255 255 / .3); transform-origin: 0 50% }
  .qa-mr .qa-fill { background: var(--orange) }
  .qa-dot {
    position: absolute; left: 4px; top: 50%; width: 12px; height: 12px; margin-top: -6px; border-radius: 50%;
    background: #fff; color: var(--night); font: 700 9px/12px var(--font-mono); text-align: center;
  }
  .qa-dot.warn { background: var(--orange) }
  .qa-mr-label { position: absolute; inset: 0; display: grid; place-items: center; font: 600 max(10px, 2.4cqi)/1 var(--font-mono); color: var(--night); white-space: nowrap }

  .frame { background: transparent; border: 2px dashed #5aa7e6; border-radius: 6px }
  .frame i { background: rgb(255 255 255 / .22) }
  .page { background: var(--white) }
  /* WP Starter: a block keeps its Figma look (light fill, dashed outline) while it travels; it fades at rest. */
  .wp-skin { position: absolute; inset: 0; border-radius: inherit; background: rgb(255 255 255 / .22); border: 1.5px dashed #5aa7e6; opacity: 0 }

  .domain { display: grid; place-items: center }
  .domain b { font: 600 11px/1 var(--font-mono); color: var(--brand) }

  /* Labels sit on a dark chip so they keep 4.5:1 on the orange visuals too. */
  .label { position: absolute; padding: 3px 6px; border-radius: 6px; background: rgb(13 10 21 / .55); font: 500 11px/1 var(--font-mono); color: #fff; letter-spacing: .04em }

  svg { position: absolute; inset: 0; width: 100%; height: 100% }
  .arrow path, .lines path { fill: none; stroke: rgb(255 255 255 / .7); stroke-width: 3; stroke-linecap: round; stroke-linejoin: round; vector-effect: non-scaling-stroke }
  .lines path { stroke-dasharray: 4 6 }
  /* Omelański: packets are short dashes that run along the paths; hidden at rest. */
  .lines .om-packet { stroke: #fff; stroke-width: 7; stroke-dasharray: 4 200; stroke-dashoffset: 4; vector-effect: none; opacity: 0 }
  .om-301 { position: absolute; padding: 3px 6px; border-radius: 6px; background: var(--night); font: 600 max(9px, 2.2cqi)/1 var(--font-mono); color: #fff; letter-spacing: .04em }
</style>
