---
import '@fontsource-variable/unbounded';
import '@fontsource-variable/manrope';
import '@fontsource/ibm-plex-mono/400.css';
import '@fontsource/ibm-plex-mono/500.css';
import '../styles/tokens.css';
import '../styles/global.css';
import { ClientRouter } from 'astro:transitions';
import { t, type Lang } from '../i18n/utils';
import Seo from '../components/Seo.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Background from '../components/Background.astro';

interface Props { lang: Lang; title: string; description: string; path: string; noindex?: boolean }
const { lang, title, description, path, noindex } = Astro.props;
---
<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <Seo lang={lang} title={title} description={description} path={path} noindex={noindex} />
    <script is:inline>
      (function () {
        var apply = function (target) {
          var stored = null;
          try { stored = localStorage.getItem('theme'); } catch (error) {}
          var dark = matchMedia('(prefers-color-scheme: dark)').matches;
          target.dataset.theme = stored === 'light' || stored === 'dark' ? stored : dark ? 'dark' : 'light';
        };
        apply(document.documentElement);
        document.addEventListener('astro:before-swap', function (event) {
          apply(event.newDocument.documentElement);
        });
      })();
    </script>
    <ClientRouter />
  </head>
  <body>
    <Background />
    <a class="skip-link" href="#main">{t(lang, 'a11y.skipToContent')}</a>
    <Header lang={lang} />
    <main id="main" class="wrap">
      <slot />
    </main>
    <Footer lang={lang} />
  </body>
</html>
<style is:global>
  .skip-link {
    position: fixed; top: 8px; left: 8px; z-index: 30; padding: 10px 16px; border-radius: 999px;
    background: var(--accent); color: var(--on-accent); font: 600 13px/1 var(--font-body);
    transform: translateY(-200%);
  }
  .skip-link:focus { transform: none }
</style>
