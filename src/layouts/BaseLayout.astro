---
import '../styles/fonts.css';
import '@fontsource-variable/manrope';
import '@fontsource/ibm-plex-mono/400.css';
import '@fontsource/ibm-plex-mono/500.css';
import '../styles/tokens.css';
import '../styles/global.css';
import { ClientRouter } from 'astro:transitions';
import { t, type Lang } from '../i18n/utils';
import Seo from '../components/Seo.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Background from '../components/Background.astro';
import Cursor from '../components/Cursor.astro';

interface Props { lang: Lang; title: string; description: string; path: string; noindex?: boolean }
const { lang, title, description, path, noindex } = Astro.props;
---
<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <Seo lang={lang} title={title} description={description} path={path} noindex={noindex} />
    <script is:inline>
      (function () {
        // `current`: the page being replaced on a client-side navigation. When storage can't be
        // read, its theme and pause choice carry over, so they last until the next full load.
        var apply = function (target, current) {
          var stored = null;
          var paused = false;
          try {
            stored = localStorage.getItem('theme');
            // "Pause animations" (motion-pause.ts): remembered across pages and visits.
            paused = localStorage.getItem('motion-paused') === '1';
          } catch (error) {
            if (current) {
              stored = current.dataset.theme;
              paused = current.classList.contains('motion-paused');
            }
          }
          // Dark unless the reader chose light (resolveTheme in theme.ts); the OS setting is not consulted.
          target.dataset.theme = stored === 'light' || stored === 'dark' ? stored : 'dark';
          target.classList.toggle('motion-paused', paused);
          // `js`: scripts run, so CSS may hide controls that only JS can reach elsewhere (the menu).
          target.classList.add('js');
        };
        // `motion`: animations may run, so CSS shows their start states from the first paint.
        // `init-pending`: removed by lifecycle.ts once every section has set itself up.
        // The timer is a safety net: if a script fails, nothing stays hidden for more than 3 s.
        var timer;
        var mark = function (target) {
          if (!matchMedia('(prefers-reduced-motion: reduce)').matches) target.classList.add('motion');
          target.classList.add('init-pending');
          clearTimeout(timer);
          timer = setTimeout(function () {
            document.documentElement.classList.remove('init-pending');
          }, 3000);
        };
        apply(document.documentElement);
        mark(document.documentElement);
        document.addEventListener('astro:before-swap', function (event) {
          apply(event.newDocument.documentElement, document.documentElement);
          mark(event.newDocument.documentElement);
        });
      })();
    </script>
    <ClientRouter />
  </head>
  <body data-cursor-open={t(lang, 'cursor.open')} data-cursor-drag={t(lang, 'cursor.drag')}>
    <Background />
    <Cursor />
    <a class="skip-link" href="#main">{t(lang, 'a11y.skipToContent')}</a>
    <Header lang={lang} />
    <!-- tabindex -1: the skip link moves keyboard focus here, not only the scroll position. -->
    <main id="main" class="wrap" tabindex="-1">
      <slot />
    </main>
    <Footer lang={lang} />
  </body>
</html>
<script>
  import { motionEnabled, onPage } from '../scripts/lifecycle';
  import { initHoverFx } from '../scripts/hover-fx';
  import { initCardLinks } from '../scripts/card-links';
  import { initMotionToggles } from '../scripts/motion-toggle';
  import { initProjectVisuals } from '../scripts/visuals/project-visual';
  onPage(initHoverFx);
  onPage(initCardLinks);
  onPage(initMotionToggles);
  // Project visual stories (ProjectVisual.astro): registered here, because a component script
  // renders inline where the component is first used, inside the first card.
  onPage(() => (motionEnabled() ? initProjectVisuals(document) : undefined));
</script>
<style is:global>
  .skip-link {
    position: fixed; top: 8px; left: 8px; z-index: 30; padding: 10px 16px; border-radius: 999px;
    background: var(--accent); color: var(--on-accent); font: 600 13px/1 var(--font-body);
    transform: translateY(-200%);
  }
  .skip-link:focus { transform: none }
  main:focus { outline: none }
</style>
