---
import BaseLayout from '../layouts/BaseLayout.astro';
import { localizePath, t } from '../i18n/utils';
---
<BaseLayout lang="en" title={`${t('en', 'notFound.title')} · ${t('pl', 'notFound.title')}`} description={t('en', 'notFound.text')} path="/">
  <section class="not-found" aria-labelledby="not-found-title">
    <p class="not-found-code">404</p>
    <h1 id="not-found-title">{t('en', 'notFound.title')} · {t('pl', 'notFound.title')}</h1>
    <p>{t('en', 'notFound.text')}</p>
    <p lang="pl">{t('pl', 'notFound.text')}</p>
    <nav class="not-found-links">
      <a href={localizePath('/', 'en')}>{t('en', 'notFound.homeEn')}</a>
      <a href={localizePath('/', 'pl')} lang="pl">{t('pl', 'notFound.homePl')}</a>
    </nav>
  </section>
</BaseLayout>
<style>
  .not-found { min-height: 70vh; padding-block: 160px 96px; display: flex; flex-direction: column; align-items: flex-start; gap: 12px }
  .not-found-code { margin: 0; font: 800 clamp(72px, 16vw, 180px)/1 var(--font-display); color: var(--accent) }
  h1 { margin: 0; font: 700 clamp(22px, 4vw, 36px)/1.15 var(--font-display) }
  p { margin: 0; color: var(--muted); font: 400 16px/1.5 var(--font-body) }
  .not-found-links { display: flex; flex-wrap: wrap; gap: 12px; margin-top: 16px }
  .not-found-links a {
    display: inline-flex; align-items: center; min-height: 44px; padding: 0 20px; border-radius: 999px;
    border: 1px solid var(--line); color: var(--ink); font: 600 14px/1 var(--font-body); text-decoration: none;
  }
  .not-found-links a:hover, .not-found-links a:focus-visible { border-color: var(--accent); color: var(--accent) }
</style>
