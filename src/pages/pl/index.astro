---
import Hero from '../../components/Hero.astro';
import TokenBuild from '../../components/TokenBuild.astro';
import Statement from '../../components/Statement.astro';
import CareerPath from '../../components/CareerPath.astro';
import Stack from '../../components/Stack.astro';
import Recommendations from '../../components/Recommendations.astro';
import WorkStack from '../../components/WorkStack.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { t } from '../../i18n/utils';
const lang = 'pl';
---
<BaseLayout lang={lang} title="Łukasz Moszczyński" description={t(lang, 'hero.sub')} path="/">
  <Hero lang={lang} />
  <TokenBuild lang={lang} />
  <Statement lang={lang} />
  <CareerPath lang={lang} />
  <Stack lang={lang} />
  <Recommendations lang={lang} />
  <WorkStack lang={lang} />
</BaseLayout>
